---
interface Props {
  name: 'document-text' | 'moon' | 'sun' | 'sparkles' | 'plus' | 'arrow-left' | 'link' | 'upload' | 'check';
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
const accessibleAttributes = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<svg class={className} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" {...accessibleAttributes}>
  {name === 'document-text' && <><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5A3.375 3.375 0 0 0 10.125 2.25H7.5A3.375 3.375 0 0 0 4.125 5.625v12.75A3.375 3.375 0 0 0 7.5 21.75h5.25" /><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 12h7.5m-7.5 3h4.5m2.25 3 1.5 1.5 3-3" /></>}
  {name === 'moon' && <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 15.002A9.718 9.718 0 0 1 12.003 21.75C6.65 21.75 2.25 17.35 2.25 12.002A9.72 9.72 0 0 1 9.001 2.25a7.5 7.5 0 0 0 12.749 12.752Z" />}
  {name === 'sun' && <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.364 6.364-1.061-1.061M6.697 6.697 5.636 5.636m12.728 0-1.061 1.061M6.697 17.303l-1.061 1.061M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />}
  {name === 'plus' && <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />}
  {name === 'arrow-left' && <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />}
  {name === 'link' && <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 6.364 6.364l-3.25 3.25a4.5 4.5 0 0 1-6.364 0m-1.88-2.876a4.5 4.5 0 0 1-6.364-6.364l3.25-3.25a4.5 4.5 0 0 1 6.364 0" />}
  {name === 'upload' && <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V3.75m0 0L7.5 8.25M12 3.75l4.5 4.5M3.75 15.75v3A1.5 1.5 0 0 0 5.25 20.25h13.5a1.5 1.5 0 0 0 1.5-1.5v-3" />}
  {name === 'check' && <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 5.25 5.25 9.75-11.25" />}
</svg>
