---
import { resolvePrincipal } from '../../adapters/better-auth/principal-resolver';
import { serverComposition } from '../../composition/server-composition';
import { CreateProjectIsland } from '../../islands/create-project-island';
import '../../styles/global.css';
const composed = serverComposition();
const principal = await resolvePrincipal(composed.auth, Astro.request);
if (!principal) return Astro.redirect('/');
const contentLocale = Astro.request.headers.get('accept-language')?.split(',')[0]?.trim() || 'en';
---
<main><p><a href="/">← Your Projects</a></p><p class="eyebrow">New Project</p><h1>Give your thinking a home.</h1><CreateProjectIsland client:load contentLocale={contentLocale} /></main>
