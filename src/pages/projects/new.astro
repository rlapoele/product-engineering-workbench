---
import { resolvePrincipal } from '@adapters/better-auth/principal-resolver';
import { resolveInitialContentLocale } from '@adapters/http/initial-content-locale';
import { serverComposition } from '@composition/server-composition';
import { AccountActionsIsland } from '@islands/account-actions-island';
import { CreateProjectIsland } from '@islands/create-project-island';
import '@styles/global.css';
const composed = serverComposition();
const principal = await resolvePrincipal(composed.auth, Astro.request);
if (!principal) return Astro.redirect('/');
const contentLocale = resolveInitialContentLocale(Astro.request.headers.get('accept-language'));
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>New Project — Product Engineering Workbench</title></head>
  <body><main><div class="page-head"><p><a href="/">← Your Projects</a></p><AccountActionsIsland client:load name={principal.name} email={principal.email} /></div><p class="eyebrow">New Project</p><h1>Give your thinking a home.</h1><CreateProjectIsland client:load contentLocale={contentLocale} /></main></body>
</html>
